# Normalise line endings to LF in the repository
* text=auto eol=lf

# Rust
*.rs text eol=lf

# Web
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binaries — do not touch
*.png binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.dylib binary
*.so binary
